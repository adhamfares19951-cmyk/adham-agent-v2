# adham-agent configuration template.
# Copy to .env and fill the values yourself in Notepad. NEVER commit .env or paste keys in chat.
# Names below match what config.py actually reads.

# --- Required ---
TELEGRAM_TOKEN=
OWNER_ID=
AI_PROVIDER=gemini
MODEL=
GEMINI_API_KEY=

# --- Optional Gemini extras ---
GEMINI_API_KEY_2=
GEMINI_BACKUP_MODEL=
ANTHROPIC_API_KEY=

# --- Local model (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=-1
# 1 = Ollama answers tool-less calls (summaries) first. Keep 0 until you pulled a model and tested it.
LOCAL_FIRST=0

# --- Optional backup providers (each is used only if both KEY and MODEL are filled) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODEL=
CLOUDFLARE_ACCOUNT_ID=
# Comma-separated fallback order, e.g. Gemini,Ollama,Groq (empty = default order)
PROVIDER_ORDER=

# --- Behaviour ---
DAILY_MESSAGE_LIMIT=200
JOB_SCAN_MINUTES=30
MORNING_BRIEF_TIME=08:00
RELIEFWEB_APPNAME=
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=4096

# --- Security switches (leave empty unless you know why) ---
# Tools disabled by default can be re-enabled by name, comma-separated.
ENABLE_TOOLS=
# Extra skills folder to index (untrusted text). Empty = only adham-agent/skills.
SKILLS_EXTRA_DIR=
