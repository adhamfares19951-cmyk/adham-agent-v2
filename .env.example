TELEGRAM_TOKEN=
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OWNER_ID=
MODEL=gemini-3.5-flash

# Backup AI provider (used automatically when the main one is busy or out of quota)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# More backup providers (optional - leave empty if you do not have a key)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Max messages per day (protects free quotas)
DAILY_MESSAGE_LIMIT=200

# Second Google AI Studio key (best from a DIFFERENT Google project = extra free quota)
GEMINI_API_KEY_2=

# Cloudflare Workers AI (backup provider)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODEL=

# Second Gemini model on the same key (separate free quota)
# (gemini-3.1-flash-lite is scheduled to shut down in May 2027; 3.5-flash-lite replaces it)
GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite

# NVIDIA NIM (free endpoint, no credit card. Key: https://build.nvidia.com -> Login -> any
# model page -> "Generate API Key". The key works for every free model on the catalog.)
# z-ai/glm-5-3-flash: multimodal, 1M context, reasoning + tool calling, fast (18B active).
# Alternatives on the same key: moonshotai/kimi-k3 (1M, agentic) or openai/gpt-oss-120b.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5-3-flash

# Z AI / Zhipu (free GLM models, 1 request at a time). Key: https://z.ai (API keys page)
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash

# Ollama Cloud (free tier with session/weekly limits). Key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# How often to check job channels/sites (minutes)
JOB_SCAN_MINUTES=30

# xKiro (third-party router with free models) - backup provider
XKIRO_API_KEY=
XKIRO_MODEL=

# Order to try AI providers (best + biggest free limit first)
PROVIDER_ORDER=Gemini,Gemini-Lite,NVIDIA,Groq,Cloudflare,Cerebras,Mistral,ZAI,Ollama,OpenRouter

# Morning brief time (24h, Gaza time) or off
MORNING_BRIEF_TIME=08:00

# ReliefWeb approved app name (leave empty until ReliefWeb approves it)
RELIEFWEB_APPNAME=

