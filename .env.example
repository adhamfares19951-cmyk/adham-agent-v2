# ==============================================================================
# adham-agent: Autonomous Multi-Agent System & Digital Twin Environment Config
# Copy this file to .env and populate your actual API keys and secrets.
# NEVER commit .env to version control.
# ==============================================================================

# Primary Engine: Google Gemini API (Using official modern google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Specialized Engine: DeepSeek API (Using OpenAI-compatible SDK)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Hybrid LLM Routing Engine (Enterprise OS Router)
# OpenRouter (Complex Coding, Architecture, Advanced Networks)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Ollama (Local VPS / Edge / Cloud for Summarization and Fast Triage)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5-coder:14b

# Provider Priority Order (comma-separated fallback chain)
PROVIDER_ORDER=Mistral,Gemini,Groq,Cloudflare,OpenRouter,Ollama


# Telegram Ingress & Digital Twin Interface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OWNER_ID=your_telegram_user_id_here

# YouTube Data API v3 Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json

# Storage & Black-board Database Configuration
SQLITE_DB_PATH=workspace_data/agent_blackboard.db

# Multi-Agent Swarm Settings
MAX_CONCURRENT_TASKS=5
JOB_SCAN_INTERVAL_MINUTES=30
TIMEZONE=Asia/Gaza

# LLM Generation Config
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=4096
