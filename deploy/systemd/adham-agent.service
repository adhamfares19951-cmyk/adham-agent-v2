[Unit]
Description=Adham Agent Telegram Autonomous Executive Bot & Watchdog
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adham-agent
ExecStart=/opt/adham-agent/venv/bin/python /opt/adham-agent/watchdog.py
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
